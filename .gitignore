# Runtime state and machine-specific files.
.workspace/
*.log
extensions.json
config.json
extensions/comfyui/settings.json
extensions/comfyui/service.json
.DS_Store
Thumbs.db

# The canvas' libraries belong to the user, not to the plugin: the workflows they save and the
# packs they add. The packs that ship with the plugin stay tracked, so a clone still has a
# node library; anything added beside them is ignored.
workflows/
packs/

# The mixed source's sandbox belongs to its extension and is user data.
extensions/mixed/workflows/
