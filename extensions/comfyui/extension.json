{
  "id": "comfyui",
  "name": "ComfyUI 兼容",
  "version": "1.0.0",
  "description": "读写 ComfyUI 前端的工作流 JSON，并带有把 ComfyUI 自定义节点包转换成 pack.json 的脚本。",
  "client": "./client.mjs",
  "host": "./host.mjs",
  "icon": "./icon.jpg",
  "settings": [
    {
      "key": "comfyuiRoot",
      "type": "path",
      "label": {
        "en": "ComfyUI folder",
        "zh": "ComfyUI 根目录"
      },
      "placeholder": "D:\\ComfyUI",
      "hint": {
        "en": "The folder that holds main.py.",
        "zh": "包含 main.py 的那个文件夹。"
      },
      "pick": "directory",
      "validate": {
        "required": true,
        "path": "directory"
      }
    },
    {
      "key": "pythonExe",
      "type": "path",
      "label": {
        "en": "Python executable",
        "zh": "Python 解释器"
      },
      "placeholder": "D:\\ComfyUI\\python\\python.exe",
      "hint": {
        "en": "Leave empty to use the python on PATH.",
        "zh": "留空则使用 PATH 里的 python。"
      },
      "pick": "file",
      "validate": {
        "path": "file"
      }
    },
    {
      "key": "comfyuiUrl",
      "type": "text",
      "label": {
        "en": "Service URL",
        "zh": "服务地址"
      },
      "placeholder": "http://127.0.0.1:8188",
      "default": "http://127.0.0.1:8188",
      "hint": {
        "en": "Where the canvas reaches ComfyUI.",
        "zh": "画布访问 ComfyUI 的地址。"
      },
      "validate": {
        "required": true,
        "pattern": "^https?://"
      }
    },
    {
      "key": "autostart",
      "type": "boolean",
      "label": {
        "en": "Start the service with the canvas",
        "zh": "随画布自动启动服务"
      },
      "default": true
    },
    {
      "key": "startupTimeoutMs",
      "type": "number",
      "label": {
        "en": "Startup timeout (ms)",
        "zh": "启动超时（毫秒）"
      },
      "default": 600000,
      "validate": {
        "min": 1000
      }
    },
    {
      "key": "stopExternal",
      "type": "boolean",
      "label": {
        "en": "Stop services this extension started",
        "zh": "停止由本拓展启动的服务"
      },
      "default": true
    }
  ]
}
