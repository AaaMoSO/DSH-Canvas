{
  "name": "示例节点包",
  "nodes": [
    {
      "type": "DemoCheckpointLoader",
      "display_name": "加载模型（示例）",
      "category": "demo/loaders",
      "description": "演示一个只有输出、带一个下拉参数的节点。",
      "inputs": [
        {
          "name": "ckpt_name",
          "type": "COMBO",
          "widget": true,
          "default": "model.safetensors",
          "options": ["model.safetensors", "another.safetensors"]
        }
      ],
      "outputs": [
        { "name": "MODEL", "type": "MODEL" },
        { "name": "CLIP", "type": "CLIP" },
        { "name": "VAE", "type": "VAE" }
      ]
    },
    {
      "type": "DemoSampler",
      "display_name": "采样器（示例）",
      "category": "demo/sampling",
      "description": "演示混合输入：模型等为纯插槽，steps/cfg 为控件。",
      "inputs": [
        { "name": "model", "type": "MODEL" },
        { "name": "positive", "type": "CONDITIONING" },
        { "name": "negative", "type": "CONDITIONING" },
        { "name": "latent_image", "type": "LATENT" },
        { "name": "steps", "type": "INT", "widget": true, "default": 20 },
        { "name": "cfg", "type": "FLOAT", "widget": true, "default": 8 },
        { "name": "denoise", "type": "FLOAT", "widget": true, "default": 1, "isOptional": true }
      ],
      "outputs": [{ "name": "LATENT", "type": "LATENT" }]
    },
    {
      "type": "DemoPreview",
      "display_name": "预览（示例）",
      "category": "demo/output",
      "inputs": [{ "name": "images", "type": "IMAGE" }],
      "outputs": []
    }
  ]
}
