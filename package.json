{
  "name": "@local/node-canvas",
  "version": "1.4.3",
  "private": true,
  "description": "An infinite node canvas in the sidebar: create nodes, wire ports, arrange a graph.",
  "type": "module",
  "engines": {
    "node": ">=20.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "executor.js",
    "node-process.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "packs/**",
    "extensions/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node test/run.cjs"
  }
}
